{
  "name": "hr-ex-phoenix",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "content": "python3 content/export_json.py && python3 content/build_drawio.py",
    "instances": "python3 scripts/build_instances.py",
    "sync": "python3 scripts/sync_daily.py",
    "sync:push": "python3 scripts/sync_and_push.py",
    "dev": "npm run content && vite",
    "build": "npm run content && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@xyflow/react": "12.12.1",
    "html-to-image": "1.11.13",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
